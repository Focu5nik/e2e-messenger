DATABASE_URL=postgresql+asyncpg://messenger:messenger@localhost:5433/messenger
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Leave empty for a single-process in-memory event bus.
REDIS_URL=redis://localhost:6379/0
# Must match across instances; use a separate channel per environment.
REDIS_CHANNEL=messenger:events
